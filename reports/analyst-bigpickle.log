UA="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36"
probe() {
  u="$1"; tag="$2"
  hdr=/tmp/hbprobe/${tag}.hdr; bdy=/tmp/hbprobe/${tag}.body
  code=$(curl -sS --max-time 25 -A "$UA" -D "$hdr" -o "$bdy" -w "%{http_code}" "$u")
  ln=$(wc -c < "$bdy")
  srv=$(grep -i '^server:' "$hdr" | head -1 | sed 's/\r//' | cut -c1-70)
  loc=$(grep -i '^location:' "$hdr" | head -1 | sed 's/\r//' | cut -c1-90)
  ct=$(grep -i '^content-type:' "$hdr" | head -1 | sed 's/\r//' | cut -c1-50)
  echo "HTTP=$code len=$ln | ${srv} | ${ct} | loc=${loc} | $tag"
  sleep 2
}
