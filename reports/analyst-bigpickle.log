programs:
  hornbach:
    name: HORNBACH Holding AG & Co. KGaA / HORNBACH Group Bug Bounty
    disclosure_policy: via bugs.olivermaicher.eu (Oliver Maicher private program) - report + PoC + contact + payment
    assets:
      - name: "All company-owned infrastructure, retail systems, e-commerce platforms, mobile applications, APIs, supply chain and logistics systems, customer accounts, in-store digital systems, and domains operated by HORNBACH Group and its subsidiaries"
        priority: In
    out_of_scope:
- "Network level Denial of Service attacks"
      - "Application Denial of Service by locking user accounts"
      - "Descriptive error messages or headers (e.g. Stack Traces, banner grabbing)"
      - "Disclosure of known public files or directories (e.g. robots.txt)"
      - "Outdated software / library versions"
      - "OPTIONS / TRACE HTTP method enabled"
      - "CSRF on logout"
      - "CSRF on forms that are available to anonymous users"
      - "Cookies that lack HTTP Only or Secure settings for non-sensitive data"
      - "Self-XSS and issues exploitable only through Self-XSS"
      - "Reports resulting from automated scanning utilities without additional details or a POC demonstrating a specific exploit"
      - "Attacks requiring physical access to a user's device"
      - "Attacks dependent upon social engineering of employees or vendors"
      - "Username enumeration based on login or forgot password pages"
      - "Enforcement policies for brute force, rate limiting, or account lockout"
      - "SSL/TLS best practices"
      - "SSL attacks such as BEAST, BREACH, Renegotiation attack"
      - "Clickjacking, without additional details demonstrating a specific exploit"
      - "Mail configuration issues including SPF, DKIM, DMARC settings"
      - "Use of a known-vulnerable library without a description of an exploit specific to our implementation"
      - "Password and account recovery policies"
      - "Presence of autocomplete functionality in form fields"
      - "Publicly accessible login panels"
      - "Lack of email address verification during account registration or account invitation"
      - "Lack of email address verification password restore"
      - "Session control during email/password changes"
      - "Social engineering, physical attacks, and DoS/DDoS testing (per program notes)"
      - "Exposure of customer/employee/financial/authentication data during testing (per program notes)"
    github_orgs:
      - none-configured

rules:
  passive_first: false          # deep-hunt agent: active probes allowed when scoped
  max_requests_per_second: 1    # never hammer live infra
  no_doom: true                 # no DoS/DDoS, no account-lockout attacks
  account_creation: restricted  # only on test/sandbox assets, never live customer data
  no_data_modification: true    # no writes/deletes on live customer data
  no_pre_disclosure: true       # never disclose before program response
  poc_required: true            # scanner output alone is REJECTED
  redact_secrets_in_commits: true

