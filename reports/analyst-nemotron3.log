<script>
    function toggle(className) {
        var elements = document.getElementsByClassName(className)
        for (var i = 0; i < elements.length; i++) {
            elements[i].style.display = "block";
        }

    }

    function goBack() {
        window.history.back();
    }

    function getCookie(cname) {
        var name = cname + "=";
        var decodedCookie = decodeURIComponent(document.cookie);
        var ca = decodedCookie.split(';');
        for (var i = 0; i < ca.length; i++) {
            var c = ca[i];
            while (c.charAt(0) == ' ') {
                c = c.substring(1);
            }
            if (c.indexOf(name) == 0) {
                return c.substring(name.length, c.length);
            }
        }
        return "";
    }

    var language = getCookie("choosenLanguage");
    var url = window.location.origin.replace(/:\d*/g, "").split('.').pop();

    if (url == "de") {
        toggle('de');
        document.getElementById('de-links').style.display = "block";
    } else if (url == "at") {
        toggle('de');
        document.getElementById('de-at').style.display = "block";
    } else if (url == "lu") {
        if (language == "fr_LU") {
            toggle('fr');
            document.getElementById('lu-fr').style.display = "block";
        } else {
            toggle('de');
            document.getElementById('lu-de').style.display = "block";
        }

    } else if (url == "nl") {
        toggle('nl');
        document.getElementById('nl-links').style.display = "block";
    } else if (url == "ch") {
        if (language == "fr_CH") {
            toggle('fr');
            document.getElementById('fr-ch').style.display = "block";
        } else {
            toggle('de');
            document.getElementById('ch-de').style.display = "block";
        }

    } else if (url == "se") {
        toggle('se');
        document.getElementById('se-links').style.display = "block";
    } else if (url == "ro") {
        toggle('ro');
        document.getElementById('ro-links').style.display = "block";
    } else if (url == "sk") {
        toggle('sk');
        document.getElementById('sk-links').style.display = "block";
    } else if (url == "cz") {
        toggle('cs');
        document.getElementById('cs-links').style.display = "block";
    } else {
        toggle('de');
        document.getElementById('de-links').style.display = "block";
    }
</script>
